# ---- 运行环境 ----
# production 会启用更严格的启动校验（例如要求 JWT_SECRET 至少 32 字符）
NODE_ENV=development
API_PORT=3000

# ---- 数据库 ----
BMS_DATABASE_ENABLED=false
DATABASE_URL=postgresql://bms:change-me@localhost:5432/business_management
SHADOW_DATABASE_URL=postgresql://bms:change-me@localhost:5432/business_management_shadow
# 验证脚本专用库：scripts/verify-*.cjs 默认连这里，避免清空开发库里的业务数据
TEST_DATABASE_URL=postgresql://bms:change-me@localhost:5432/business_management_test
TEST_SHADOW_DATABASE_URL=postgresql://bms:change-me@localhost:5432/business_management_test_shadow

# ---- 安全 ----
# 必填。缺失时服务会拒绝启动（而不是回退到不安全的默认值）。
# 生产要求至少 32 字符，生成方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-before-use
SEED_ADMIN_PASSWORD=change-me-before-seed

# 允许跨域的前端来源，逗号分隔。留空时仅允许 http://localhost:5173。
# 生产推荐由 IIS 同源反向代理 /api 到本服务，此时无需配置本项。
# 注意：本服务启用了 credentials，因此不允许使用通配符 "*"。
CORS_ORIGINS=

# ---- 附件存储 ----
FILE_STORAGE_DRIVER=local
# 相对路径按「apps/api 包根目录」解析（不随启动进程的工作目录漂移）。
# 生产建议直接写绝对路径，例如 D:\bms\storage\uploads
FILE_STORAGE_PATH=../../storage/uploads
FILE_MAX_SIZE_MB=20
# 逗号分隔的 MIME 类型；留空使用系统默认允许列表
FILE_ALLOWED_MIME_TYPES=
